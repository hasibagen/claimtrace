{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki/schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "evidence node frontmatter schema (ARCHITECTURE §3.4 + §15.4.11 增强 + paper_stats 整合). 所有字段扁平化为顶层 verify_*/interp_*/prov_*/extract_* 单层键值对,Obsidian 笔记属性面板可读.",
  "type": "object",
  "required": [
    "type",
    "fact_type",
    "observation",
    "interp_origin",
    "interp_text",
    "prov_paper",
    "prov_section",
    "prov_source_text",
    "verify_n",
    "verify_test_method"
  ],
  "properties": {
    "type": {
      "const": "evidence"
    },
    "schema_version": {
      "const": "plan_final_v1"
    },
    "evidence_id": {
      "type": "string",
      "description": "DEPRECATED(批次3删除):历史编号残留;唯一标识 = 文件名(§3.4)"
    },
    "fact_type": {
      "enum": [
        "empirical_result",
        "observation",
        "methodology",
        "secondary_citation"
      ],
      "description": "事实分类;secondary_citation=二手引文(Intro/Discussion 转述他人结果,不得当本文实证,ChatGPT §33)"
    },
    "source": {
      "type": "string",
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "来源论文 wikilink (扁平化,ARCHITECTURE §3.4)"
    },
    "observation": {
      "type": "string",
      "minLength": 20,
      "description": "原文 verbatim (≥20 字符,从 raw full.md 复制)"
    },
    "interp_origin": {
      "enum": [
        "author",
        "reviewer",
        "system"
      ],
      "description": "Flat interpretation.origin (ARCHITECTURE §3.4 扁平化)"
    },
    "interp_text": {
      "type": "string",
      "minLength": 5,
      "description": "Flat interpretation.text"
    },
    "prov_paper": {
      "type": "string",
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Flat provenance.paper"
    },
    "prov_section": {
      "type": "string",
      "description": "Flat provenance.section"
    },
    "prov_page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Flat provenance.page"
    },
    "prov_paragraph": {
      "type": "integer",
      "minimum": 1,
      "description": "Flat provenance.paragraph"
    },
    "prov_source_text": {
      "type": "string",
      "minLength": 10,
      "description": "可定位到 raw full.md 的原文"
    },
    "extract_model": {
      "type": "string"
    },
    "extract_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "extract_method": {
      "enum": [
        "llm_semantic"
      ]
    },
    "extract_temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "verify_status": {
      "enum": [
        "verified",
        "unverified",
        "flagged"
      ],
      "description": "Flat provenance.verification.status"
    },
    "verify_verifier": {
      "type": "string",
      "description": "Flat provenance.verification.verifier"
    },
    "verify_n": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "样本量(方法学/软件论文无样本量时 null)"
    },
    "verify_test_method": {
      "$ref": "#/$defs/test_method_enum",
      "description": "检验方法(从 paper_stats.md 候选清单精确匹配,scripts 严格校验)"
    },
    "verify_test_stat_type": {
      "$ref": "#/$defs/test_stat_type_enum",
      "description": "统计量类型"
    },
    "verify_test_stat_value": {
      "type": [
        "number",
        "null"
      ],
      "description": "统计量数值(null=论文未报告)"
    },
    "verify_effect_size_type": {
      "$ref": "#/$defs/effect_size_type_enum",
      "description": "效应量类型"
    },
    "verify_effect_size_value": {
      "type": [
        "number",
        "null"
      ],
      "description": "效应量数值(null=论文未报告)"
    },
    "verify_ci_95": {
      "type": [
        "string",
        "null"
      ],
      "description": "95% CI 字符串形式 '[下界,上界]'(null=未报告)"
    },
    "verify_df": {
      "type": [
        "integer",
        "null"
      ],
      "description": "自由度(null=论文未报告)"
    },
    "verify_p_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "p 值(null=论文未报告)"
    },
    "verify_p_method": {
      "$ref": "#/$defs/p_method_enum",
      "description": "p 值校正方法"
    },
    "verify_note": {
      "type": "string",
      "description": "备注(论文未报告的字段说明原因;方法论论文置 '无假设检验,n=... 描述对象')"
    },
    "supports_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      },
      "description": "边目标 wikilink(扁平化 3 数组对齐)"
    },
    "supports_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "supports_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "contradicts_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      }
    },
    "contradicts_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "contradicts_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "qualifies_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      }
    },
    "qualifies_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "qualifies_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "strength": {
      "enum": [
        "strong",
        "moderate",
        "weak"
      ],
      "description": "科学证据强度(≠ LLM 抽取置信度)"
    },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "LLM 对自己抽取的自信程度"
    },
    "field_status": {
      "type": "object",
      "description": "fail-closed 字段状态(批次4,gpt5.6sol §十):reported=原文明确/not_reported=未报告/inferred=推断;禁止默认值推断",
      "properties": {
        "mode": {
          "enum": [
            "reported",
            "not_reported",
            "inferred"
          ]
        },
        "suspiciously_complete": {
          "type": "boolean",
          "description": "字段过全报警(防幻觉)"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "test_method_enum": {
      "description": "从 .skill/references/templates/paper_stats.md 提取的检验方法候选清单 (T-W4-024 整合)",
      "enum": [
        "t_test_one_sample",
        "t_test_independent",
        "t_test_paired",
        "anova_one_way",
        "anova_rm",
        "anova_mixed",
        "anova_multi_factor",
        "regression_linear",
        "regression_multiple",
        "regression_logistic",
        "regression_polynomial",
        "correlation_pearson",
        "correlation_spearman",
        "correlation_kendall",
        "ancova",
        "mann_whitney",
        "wilcoxon",
        "kruskal_wallis",
        "friedman",
        "rank_sum",
        "permutation_test",
        "spin_test",
        "mixed_effects_lmm",
        "flame",
        "ols_cluster",
        "bayesian_regression",
        "bayesian_hierarchical",
        "bayes_factor",
        "voxelwise_linear_regression",
        "voxelwise_t_test",
        "nested_cv",
        "loso",
        "louo",
        "methodology",
        "framework_design",
        "ontology_design",
        "descriptive"
      ]
    },
    "test_stat_type_enum": {
      "description": "统计量类型(paper_stats.md 候选清单 + na;批次1 补 na:方法论论文无统计量是合法态)",
      "enum": [
        "t",
        "F",
        "r",
        "rho",
        "chi2",
        "OR",
        "RR",
        "beta",
        "z",
        "u",
        "W",
        "H",
        "Q",
        "BF",
        "d",
        "g",
        "R2",
        "eta2",
        "V",
        "phi",
        "na"
      ]
    },
    "effect_size_type_enum": {
      "description": "效应量类型(paper_stats.md 候选清单)",
      "enum": [
        "cohen_d",
        "hedges_g",
        "r",
        "rho",
        "r_squared",
        "R_squared",
        "adjusted_R_squared",
        "eta_squared",
        "partial_eta_squared",
        "beta",
        "OR",
        "RR",
        "phi",
        "cramers_v",
        "bayes_factor",
        "na"
      ]
    },
    "p_method_enum": {
      "description": "p 值校正/多重比较方法(paper_stats.md 多重比较章节候选清单)",
      "enum": [
        "uncorrected",
        "bonferroni",
        "holm_bonferroni",
        "fwe",
        "maxT",
        "fdr_bh",
        "fdr_by",
        "cluster_based",
        "tfce",
        "bayes_factor",
        "na"
      ]
    }
  }
}