{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki/schemas/claim.schema.json",
  "title": "Claim",
  "description": "claim node frontmatter schema (ARCHITECTURE §3.5, 扁平化重写 2026-08-25 批次1:对齐 324 个现存节点的扁平字段;additionalProperties 暂宽,enum 严格——违规值即批次3清洗目标)",
  "type": "object",
  "required": [
    "type",
    "statement",
    "claim_type",
    "verify_status"
  ],
  "properties": {
    "type": {
      "const": "claim"
    },
    "schema_version": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "一句话陈述,关键命题"
    },
    "claim_type": {
      "enum": [
        "empirical_result",
        "empirical_generalization",
        "theoretical_interpretation",
        "methodological",
        "meta_analytic"
      ]
    },
    "origin": {
      "enum": [
        "extracted",
        "author",
        "normalized",
        "synthesized"
      ],
      "description": "claim 出处 (GPT §二十三)"
    },
    "atomic": {
      "type": "boolean",
      "description": "是否原子化(GPT §22)"
    },
    "scope_population": {
      "type": "string"
    },
    "scope_modality": {
      "type": "string"
    },
    "scope_task": {
      "type": "string"
    },
    "scope_region": {
      "type": "string"
    },
    "scope_study_design": {
      "type": "string"
    },
    "verify_status": {
      "enum": [
        "supported",
        "partial",
        "contradicted",
        "no_evidence"
      ]
    },
    "verify_confidence": {
      "type": [
        "number",
        "string"
      ],
      "description": "0-1 数值(历史数据混有 high/low 枚举,批次3清洗后收紧为 number)"
    },
    "verify_strength": {
      "enum": [
        "strong",
        "moderate",
        "weak",
        "inconclusive"
      ]
    },
    "verify_consensus": {
      "enum": [
        "established",
        "emerging",
        "fringe"
      ]
    },
    "verify_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "verify_supporting_count": {
      "type": "integer",
      "minimum": 0
    },
    "verify_contradicting_count": {
      "type": "integer",
      "minimum": 0
    },
    "verify_evidence_quality": {
      "type": "string"
    },
    "verify_last_updated": {
      "type": "string"
    },
    "reasoning": {
      "type": "string",
      "description": "Toulmin warrant 降级(GPT §四)"
    },
    "reasoning_type": {
      "enum": [
        "empirical_inference",
        "theoretical_assumption",
        "methodological_design"
      ]
    },
    "sources_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      }
    },
    "sources_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "sources_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "supports_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      }
    },
    "supports_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "supports_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "contradicts_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      }
    },
    "contradicts_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "contradicts_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "evidence_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      }
    },
    "evidence_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "evidence_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "claim_origin": {
      "enum": [
        "author_conclusion",
        "extracted",
        "normalized",
        "synthesized",
        "user"
      ],
      "description": "主张来源分层(批次4,GPT §三十四):铁律 #9 CLAIM≠PAPER CONCLUSION 的机械化"
    },
    "attribution": {
      "enum": [
        "author_own",
        "cited_single",
        "cited_multi",
        "field_consensus"
      ],
      "description": "观点归属(T-W7-001,前言/讨论抽取升级,Cargill-O'Connor §8.3 句式分类):author_own=本文作者自己的推断/结果;cited_single=转述单一被引文献特定主张;cited_multi=多文献弱归属(several studies reported);field_consensus=信息主导的领域共识(无归属或泛引)"
    },
    "origin_section": {
      "enum": [
        "abstract",
        "introduction",
        "methods",
        "results",
        "discussion",
        "conclusion",
        "review"
      ],
      "description": "该 claim 在论文中的出处章节(T-W7-001):results=实证发现(默认);introduction/discussion=论证链 claim;review=综述正文转述"
    },
    "cited_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      },
      "description": "被引文献 wikilink(attribution=cited_* 时;库内指向 paperinfo/<citekey>)"
    },
    "cited_apa": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "被引文献 APA 条目(attribution=cited_* 且库外时;从论文 References 表 verbatim 抄录,含 DOI;库内文献也应抄录以便 claim 页直接可读)"
    },
    "argument_role": {
      "enum": [
        "background",
        "gap",
        "purpose",
        "finding",
        "interpretation",
        "comparison",
        "alternative",
        "implication",
        "limitation",
        "future"
      ],
      "description": "论证链角色(T-W7-001,CARS + Discussion moves + Research-Pilot PUG 降级):background=领域共识背景/gap=缺口反主张/purpose=本研究目的假设/finding=实证发现/interpretation=机制解释/comparison=与文献对比/alternative=替代解释/implication=意义应用/limitation=局限/future=未来方向"
    },
    "premises_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[^\\]]+\\]\\]$"
      },
      "description": "逻辑前提边(T-W7-001):本 claim 由哪些 claim 推出(通常同论文:discussion 解释←results 发现+introduction 背景);与 supports(跨论文立场支持)区分"
    },
    "premises_confidences": {
      "type": "array",
      "items": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    },
    "premises_relations": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "indirect",
          "partial"
        ]
      }
    },
    "role_in_paper": {
      "enum": [
        "central",
        "supporting",
        "ancillary"
      ],
      "description": "论文内层级(2026-09-16 深度升级,源=mn 笔记 claim 树):central=核心主张(通常 1-3 条,T2b 深度回读对象);supporting=支撑主张;ancillary=边缘/次要。缺省视作 supporting"
    },
    "polarity": {
      "enum": [
        "positive",
        "negative",
        "null_result",
        "mixed"
      ],
      "description": "方向极性(2026-09-16 深度升级,源=SciClaim magnitude 降级):negative=方向性负效应;null_result=零结果/无显著差异(默认建 claim,禁默默丢弃);mixed=条件依赖的双向结果"
    },
    "epistemic_stance": {
      "enum": [
        "demonstrated",
        "inferred",
        "hypothetical",
        "contested"
      ],
      "description": "作者立场(2026-09-16 深度升级,源=SciClaim epistemic 降级;与 origin 的 provenance 语义区分):demonstrated=本文实证证明;inferred=作者推断/解释;hypothetical=假说或纯推测;contested=领域内存在争议"
    },
    "qualifier": {
      "type": "string",
      "minLength": 10,
      "description": "作者限定/对冲措辞(2026-09-16 深度升级,源=Toulmin qualifier + mn 笔记维度14):英文原文 hedging 原样保留(may/suggests/some evidence/not necessarily…)+中文一句话说明。无则不写该字段,禁空串"
    },
    "boundary": {
      "type": "string",
      "minLength": 10,
      "description": "成立边界与失效条件(2026-09-16 深度升级,源=Craft of Research 回应质疑 + mn 笔记局限维度):作者明示的局限+该 claim 未覆盖的人群/条件/任务——该证据不能证明什么。无则不写,禁空串"
    },
    "alternative_explanations": {
      "type": "string",
      "minLength": 10,
      "description": "替代解释(2026-09-16 深度升级,源=Toulmin rebuttal + mn 笔记替代解释维度):作者承认的+承认未排除的其他解释。无则不写,禁空串"
    }
  },
  "additionalProperties": true
}